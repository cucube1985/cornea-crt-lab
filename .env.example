# Set these in your host's environment/secret settings. Node does not auto-load this file.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-server.example
PORT=4173
AUTH_DATA_DIR=/app/.private
# First launch only. Enter the initial admin password as a hosting secret.
ADMIN_INITIAL_PASSWORD=
# Enable only behind one trusted reverse proxy that appends/sanitizes X-Forwarded-For.
TRUST_PROXY=0
